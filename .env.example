# On a deployed school server set APP_ENV=production and APP_DEBUG=false.
# (As a safety net, production forces debug off regardless — see AppServiceProvider.)
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_TIMEZONE=UTC
APP_NAME="KUBO"

# Shared secret for off-device backup tooling that POSTs to /api/backup/report.
# The on-device backup cron uses loopback and doesn't need this.
BACKUP_REPORT_TOKEN=

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kubo
DB_USERNAME=
DB_PASSWORD=
DB_TESTING_DATABASE=kubo_testing
DB_TESTING_USERNAME=
DB_TESTING_PASSWORD=

CACHE_DRIVER=file
QUEUE_DRIVER=sync

