# Template for a production install. Copy it to .env and fill it in.
#
# Do NOT name this file .env.production: Laravel treats .env.<APP_ENV> as a real
# environment file and loads it INSTEAD of .env when APP_ENV=production, so a
# template with placeholder database credentials silently takes over the server's
# own .env. (That is exactly what happened on the demo box.)

APP_NAME="KUBO"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_TIMEZONE=UTC
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=kubo
DB_USERNAME=kubo
DB_PASSWORD=

# Admin credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRSTNAME=kubo
ADMIN_LASTNAME=admin

# Kolibri integration
KOLIBRI_URL=http://localhost:8090
KOLIBRI_USERNAME=admin
KOLIBRI_PASSWORD=
KOLIBRI_LEARNER_SECRET=
KOLIBRI_CONTENT_PATH=

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Cache
CACHE_DRIVER=file

# Queue (synchronous — no background workers needed)
QUEUE_CONNECTION=sync
